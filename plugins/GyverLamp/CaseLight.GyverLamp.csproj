<Project Sdk="Microsoft.NET.Sdk">

  <!-- Плагин CaseLight для ламп на прошивке GyverLamp-Wa1den: кадры по сети, протокол DDP.
       Кладётся папкой в plugins рядом с программой:
       dotnet publish plugins/GyverLamp -c Release -o dist/plugins/GyverLamp -->
  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>CaseLight.GyverLamp</RootNamespace>
    <AssemblyName>CaseLight.GyverLamp</AssemblyName>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Контракт берётся у программы во время работы: копия рядом с плагином дала бы
         второй экземпляр интерфейса, который программа не узнает. -->
    <ProjectReference Include="..\..\src\CaseLight.Plugins\CaseLight.Plugins.csproj" Private="false" />
  </ItemGroup>

</Project>
