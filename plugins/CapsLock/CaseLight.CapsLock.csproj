<Project Sdk="Microsoft.NET.Sdk">

  <!-- Плагин-эффект CaseLight: индикатор Caps Lock на выбранном диоде. Кладётся папкой в
       plugins рядом с программой или с настройками:
       dotnet publish plugins/CapsLock -c Release -o dist/plugins/CapsLock -->
  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>CaseLight.CapsLock</RootNamespace>
    <AssemblyName>CaseLight.CapsLock</AssemblyName>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Контракт берётся у программы во время работы: копия рядом с плагином дала бы
         второй экземпляр интерфейса, который программа не узнает. -->
    <ProjectReference Include="..\..\src\CaseLight.Plugins\CaseLight.Plugins.csproj" Private="false" />
  </ItemGroup>

</Project>
