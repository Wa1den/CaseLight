<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Matches Rimlight.Core, whose capture backends need the Windows 10 SDK surface. -->
    <TargetFramework>net9.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22621.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- Трей и выбор цвета: в WPF нет ни того, ни другого. -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>CaseLight</RootNamespace>
    <AssemblyName>CaseLight</AssemblyName>
    <ApplicationIcon>icon.ico</ApplicationIcon>

    <!-- ThemeMode (Fluent) is still marked experimental in .NET 9 -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>

    <Version>0.9.0</Version>
    <Product>CaseLight</Product>
    <Authors>Wa1den</Authors>
    <Description>Подсветка корпуса как продолжение экрана, через OpenRGB</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Also embedded, so the window itself can show it, not just the exe in Explorer. -->
    <Resource Include="icon.ico" />
    <PackageReference Include="OpenRGB.NET" Version="3.1.1" />

    <!-- Capture, colour pipeline, frame bus and power handling. Lives inside this
         repository on purpose: the case lighting has to work on a machine that has no
         monitor strip and no external controller, so it cannot depend on Rimlight. -->
    <ProjectReference Include="..\CaseLight.Core\CaseLight.Core.csproj" />
  </ItemGroup>

</Project>
