<Project Sdk="Microsoft.NET.Sdk">

  <!-- Контракт между CaseLight и плагинами устройств. Без WPF и без зависимостей: плагин
       ссылается только на эту сборку, а во время работы получает её копию из программы. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>CaseLight.Plugins</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
